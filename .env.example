# Recommended pilot storage: attach a PRIVATE Vercel Blob store. Never expose this token.
BLOB_READ_WRITE_TOKEN=
# Optional alternative: a PostgreSQL connection takes precedence over Blob.
DATABASE_URL=
# Generate the following values using npm run setup; passwords are hashed.
SESSION_SECRET=
ADMIN_USERNAME=developer
ADMIN_PASSWORD_HASH=
OWNER_ACCOUNTS_JSON=[]
# Optional stable production origin for QR code checks, e.g. https://localbite.vercel.app
APP_ORIGIN=
# Optional customer identity. Enable providers in Supabase before using Google/SMS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
